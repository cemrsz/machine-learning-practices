import numpy as np
import matplotlib.pyplot as plt

# x: çalışma saati, y: sınav puanı
x = np.array([1, 2, 3, 4, 5, 6], dtype=float)
y = np.array([45, 50, 55, 65, 70, 78], dtype=float)

w = 0.0
b = 0.0
learning_rate = 0.01


for _ in range(1000):
    y_pred = w * x + b
    error = y_pred - y

    dw = (2 / len(x)) * np.sum(error * x)
    db = (2 / len(x)) * np.sum(error)

    w -= learning_rate * dw
    b -= learning_rate * db

model=w*x+b

print(f"w: {w:.2f}, b: {b:.2f}")
print(f"7 saat çalışanın tahmini puanı: {w * 7 + b:.1f}")

plt.scatter(x, y, label="Gerçek veri")
plt.plot(x,model, color="red", label="Model doğrusu")
plt.xlabel("Çalışma saati")
plt.ylabel("Sınav puanı")
plt.legend()
plt.show()