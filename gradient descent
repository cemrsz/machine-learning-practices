import numpy as np
import matplotlib.pyplot as plt
import pandas as pd
from sklearn.preprocessing import LabelEncoder




# Veri seti
data = {
    "çalışma_saati": [1, 2, 3, 4, 5, 6],
    "sınav_puanı": [45, 50, 55, 65, 70, 78],
    "student": ["A", "B", "C", "D", "E", "F"],
    "Okul": [
        "nedim uysal anadolu",
        "ahmet yesevi anadolu",
        "mehmet akif anadolu",
        "mehmet akif anadolu",
        "ahmet yesevi anadolu",
        "mehmet akif anadolu"
    ]
}

# DataFrame oluştur
df = pd.DataFrame(data)







# Metinleri sayısal değerlere çevir
okul_encoder = LabelEncoder() #label encoder sınıfını çağırdım
student_encoder = LabelEncoder() #label encoder sınıfını çağırdım

df["okul_encoded"] = okul_encoder.fit_transform(df["Okul"]) #okul kolonunu sayısal değerlere çevir sorun cıkmasın diye ayrı kolon açtım
df["student_encoded"] = student_encoder.fit_transform(df["student"]) #studentleri de aynı şekilde sayısal değerlere çeviriyorum

# Kontrol
print(df[["student", "student_encoded", "Okul", "okul_encoded"]])








# x: çalışma saati, y: sınav puanı
x=df[["çalışma_saati","okul_encoded"]].to_numpy(dtype=float) 
y=df[["student_encoded","sınav_puanı"]].to_numpy(dtype=float)

w = 0.0
b = 0.0
alpha = 0.01 #learning rate
model = w * x + b #Linear model

def gradient_descent(): #kademeleli azaltma fonksiynonu
    w = 0.0
    b = 0.0
    alpha = 0.01 #learning rate

    for _ in range(1000):
        model = w * x + b #Linear model çift tanım var biliyorum ama bunu silsek problem olmaz çünkü gradient descent fonksiyonu dısında tanımladık
        error = model - y #loss function

    dw = (2 / len(x)) * np.sum(error * x) #loss function'un türevi
    db = (2 / len(x)) * np.sum(error) #loss function'un türevi dw, db → “Daha az yanlış olmak için w ve b hangi yönde değişmeli?”

    w = w - alpha * dw #gradient descent güncelleme kuralı w için
    b = b - alpha * db #gradient descent güncelleme kuralı b için


print(f"w: {w:.2f}, b: {b:.2f}")
print(f"7 saat çalışanın tahmini puanı: {w * 7 + b:.1f}")

plt.scatter(x, y, label="Gerçek veri")
plt.plot(x,model, color="red", label="Model doğrusu")
plt.xlabel("Çalışma saati")
plt.ylabel("Sınav puanı")
plt.legend()
plt.show()